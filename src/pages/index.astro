---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import ofertasRaw from "../data/ofertas.json";

interface Oferta {
  platform: "amazon" | "shopee" | "mercadolivre" | string;
  asin: string;
  title: string;
  price: number | null;
  original_price: number | null;
  discount_percent: number | null;
  rating: number | null;
  review_count: string | null;
  image_url: string;
  affiliate_url: string;
  collected_at: string;
}

const ofertas = (ofertasRaw as Oferta[]).filter((o) => o.affiliate_url && o.title);

const PLATFORMS: Record<string, { label: string; badgeBg: string; badgeText: string; dot: string }> = {
  amazon: { label: "Amazon", badgeBg: "bg-store-amazon-badge", badgeText: "text-store-amazon-primary", dot: "bg-store-amazon-primary" },
  shopee: { label: "Shopee", badgeBg: "bg-store-shopee-badge", badgeText: "text-store-shopee-primary", dot: "bg-store-shopee-primary" },
  mercadolivre: { label: "Mercado Livre", badgeBg: "bg-store-mercadolivre-primary", badgeText: "text-store-mercadolivre-badge", dot: "bg-store-mercadolivre-primary" },
};

function platformMeta(key: string) {
  return PLATFORMS[key] ?? { label: key, badgeBg: "bg-surface-container-high", badgeText: "text-on-surface", dot: "bg-outline" };
}

function formatBRL(value: number | null) {
  if (value === null || value === undefined) return null;
  return value.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}

function savingsLabel(o: Oferta) {
  if (o.price != null && o.original_price != null && o.original_price > o.price) {
    return `Economize ${formatBRL(o.original_price - o.price)}`;
  }
  if (o.discount_percent) return `-${Math.round(o.discount_percent)}% OFF`;
  return null;
}

function formatWhen(raw: string) {
  // "YYYY-MM-DD HH:MM:SS" (horário de Brasília, já vem pronto do coletor)
  const m = raw?.match(/^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2})/);
  if (!m) return raw ?? "";
  const [, , mo, d, h, mi] = m;
  return `${d}/${mo} às ${h}:${mi}`;
}

function normalize(s: string) {
  return (s || "")
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLowerCase();
}

const sorted = [...ofertas].sort((a, b) => (b.collected_at || "").localeCompare(a.collected_at || ""));
const platformsPresent = Array.from(new Set(sorted.map((o) => o.platform)));
const countsByPlatform: Record<string, number> = {};
for (const o of sorted) countsByPlatform[o.platform] = (countsByPlatform[o.platform] || 0) + 1;
const latest = sorted[0]?.collected_at ? formatWhen(sorted[0].collected_at) : null;
---

<Base
  title="Central de Ofertas — Amazon, Shopee e Mercado Livre num lugar só"
  description="Todas as ofertas que a gente encontra na Amazon, Shopee e Mercado Livre — não só o top 5 que cabe no Telegram. Atualiza sozinho, direto da fonte."
>
  <SiteHeader latest={latest} />

  <div class="sticky top-0 z-20 bg-surface-card/95 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.06)]" id="toolbar">
    <div class="max-w-[1440px] mx-auto px-margin md:px-margin-desktop py-space-sm flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-space-md">
      <div class="flex items-center gap-space-xs overflow-x-auto pb-space-xs lg:pb-0" id="platform-pills">
        <button
          type="button"
          class="store-filter-btn is-active px-space-lg py-space-xs rounded-full font-label-action text-label-action transition-all flex items-center gap-space-xs bg-primary text-on-primary shrink-0"
          data-platform-filter="all"
        >
          <span>Todas</span>
          <span class="px-space-xs py-0.5 rounded-full text-[10px] bg-white/20" data-count-all>{sorted.length}</span>
        </button>
        {
          platformsPresent.map((p) => {
            const meta = platformMeta(p);
            return (
              <button
                type="button"
                class="store-filter-btn px-space-lg py-space-xs rounded-full font-label-action text-label-action transition-all flex items-center gap-space-xs bg-surface-container-lowest text-text-muted hover:text-on-surface shadow-sm shrink-0"
                data-platform-filter={p}
              >
                <span class={`w-2 h-2 rounded-full ${meta.dot}`} />
                <span>{meta.label}</span>
                <span class="px-space-xs py-0.5 rounded-full text-[10px] bg-surface-container-high">{countsByPlatform[p]}</span>
              </button>
            );
          })
        }
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-sm">
        <div class="relative min-w-[240px] flex-1">
          <Icon name="search" class="absolute left-space-md top-1/2 -translate-y-1/2 w-[18px] h-[18px] text-text-muted" />
          <input
            id="search-input"
            class="w-full bg-surface-container-lowest text-on-surface font-body-sm text-body-sm pl-9 pr-space-md py-space-xs rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary"
            type="search"
            placeholder="buscar: fone, air fryer, tênis..."
            autocomplete="off"
          />
        </div>
        <div class="relative">
          <select
            id="sort-select"
            class="w-full sm:w-auto appearance-none bg-surface-container-lowest text-on-surface font-label-action text-label-action pl-space-md pr-8 py-space-xs rounded-lg shadow-sm focus:outline-none cursor-pointer"
          >
            <option value="recent">ordenar: mais recentes</option>
            <option value="discount">ordenar: maior desconto</option>
          </select>
          <Icon name="chevron-down" class="absolute right-space-xs top-1/2 -translate-y-1/2 w-[18px] h-[18px] pointer-events-none text-text-muted" />
        </div>
      </div>
    </div>
  </div>

  <main class="max-w-[1440px] mx-auto px-margin md:px-margin-desktop py-space-lg">
    <p class="font-body-sm text-body-sm text-text-muted mb-space-md" id="results-count" aria-live="polite"></p>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-gutter" id="grid">
      {
        sorted.map((o) => {
          const meta = platformMeta(o.platform);
          const badge = savingsLabel(o);
          return (
            <article
              class="deal-card group flex flex-col justify-between bg-surface-card rounded-xl p-space-md shadow-sm hover:shadow-md transition-all duration-200"
              data-platform={o.platform}
              data-discount={o.discount_percent ?? 0}
              data-collected={o.collected_at}
              data-title={normalize(o.title)}
            >
              <a
                class="flex flex-col h-full"
                href={o.affiliate_url}
                target="_blank"
                rel="noopener sponsored"
                data-analytics-event="select_offer"
                data-analytics-params={JSON.stringify({
                  platform: o.platform,
                  item_id: o.asin,
                  item_name: o.title,
                  price: o.price,
                  discount_percent: o.discount_percent,
                })}
              >
                <div class="relative w-full aspect-square bg-canvas-base/50 rounded-lg overflow-hidden flex items-center justify-center p-space-sm mb-space-sm">
                  <img
                    class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                    src={o.image_url}
                    alt=""
                    loading="lazy"
                  />
                  <span class={`absolute top-space-xs left-space-xs inline-flex items-center px-space-sm py-space-xs rounded font-label-store text-label-store uppercase ${meta.badgeBg} ${meta.badgeText}`}>
                    {meta.label}
                  </span>
                  {o.discount_percent ? (
                    <span class="absolute top-space-xs right-space-xs inline-flex items-center px-space-sm py-space-xs rounded-full font-badge-discount text-badge-discount bg-discount-pill-bg text-discount-pill-text shadow-sm">
                      -{Math.round(o.discount_percent)}%
                    </span>
                  ) : null}
                </div>
                <div class="flex flex-col gap-space-xs mb-space-sm">
                  {o.rating ? (
                    <div class="flex items-center gap-space-xs font-body-sm text-body-sm text-text-muted">
                      <Icon name="star" class="w-[15px] h-[15px] text-amber-500" />
                      <span class="font-semibold text-on-surface">{o.rating.toFixed(1)}</span>
                      {o.review_count ? <span>({o.review_count})</span> : null}
                    </div>
                  ) : null}
                  <h2 class="font-headline-sm text-headline-sm font-semibold text-on-surface line-clamp-2 leading-snug group-hover:text-secondary transition-colors">
                    {o.title}
                  </h2>
                </div>
                <div class="mt-auto pt-space-sm flex flex-col gap-space-sm">
                  <div class="flex items-baseline justify-between gap-space-xs flex-wrap">
                    <div class="flex flex-col">
                      {formatBRL(o.original_price) && o.original_price! > (o.price ?? 0) ? (
                        <span class="font-price-strikethrough text-price-strikethrough text-text-muted line-through">
                          de {formatBRL(o.original_price)}
                        </span>
                      ) : null}
                      <span class="font-price-featured text-price-featured text-primary tracking-tight">{formatBRL(o.price)}</span>
                    </div>
                    {badge ? <span class="text-savings-positive font-label-action text-label-action font-bold">{badge}</span> : null}
                  </div>
                  <span class="w-full flex items-center justify-center gap-space-xs py-space-xs px-space-md rounded-lg bg-primary group-hover:bg-primary-container text-on-primary font-label-action text-label-action transition-all">
                    <span>Pegar Promoção</span>
                    <Icon name="arrow-up-right" class="w-[16px] h-[16px]" />
                  </span>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>

    <div class="hidden flex-col items-center justify-center py-16 px-space-md text-center bg-surface-container-lowest rounded-xl shadow-sm mt-space-md" id="empty-state">
      <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-text-muted mb-space-md">
        <Icon name="search-off" class="w-[28px] h-[28px]" />
      </div>
      <p class="font-headline-sm text-headline-sm font-semibold text-on-surface max-w-md">
        Nenhuma oferta bateu com essa busca. Tenta outra palavra ou limpa o filtro.
      </p>
      <button
        type="button"
        class="mt-space-md px-space-lg py-space-xs rounded-full bg-primary text-on-primary font-label-action text-label-action transition-transform active:scale-95 shadow-sm"
        id="reset-filters"
      >
        Limpar busca e filtros
      </button>
    </div>

    <div class="mt-space-xl p-space-md rounded-xl bg-surface-container text-text-muted flex items-start gap-space-sm">
      <Icon name="info" class="w-[20px] h-[20px] text-text-muted shrink-0 mt-0.5" />
      <p class="font-body-sm text-body-sm leading-relaxed">
        Os links são de afiliado — a gente pode ganhar uma comissão em compras feitas por aqui, sem custo extra pra
        você. Preços e estoque são dos próprios sites e podem mudar a qualquer momento.
        <br />
        Como Associados Amazon, ganhamos com compras qualificadas.
      </p>
    </div>
  </main>

  <Footer />
</Base>

<script>
  type CardInfo = {
    el: HTMLElement;
    platform: string;
    discount: number;
    collected: string;
    title: string;
  };

  const grid = document.getElementById("grid");
  const resultsCount = document.getElementById("results-count");
  const emptyState = document.getElementById("empty-state");
  const pillsWrap = document.getElementById("platform-pills");
  const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  const resetBtn = document.getElementById("reset-filters");

  function track(name: string, params: Record<string, unknown> = {}) {
    if (typeof (window as any).gtag === "function") (window as any).gtag("event", name, params);
  }

  if (grid && resultsCount && emptyState && pillsWrap && sortSelect && searchInput) {
    const cards: CardInfo[] = Array.from(grid.querySelectorAll<HTMLElement>(".deal-card")).map((el) => ({
      el,
      platform: el.dataset.platform || "",
      discount: Number(el.dataset.discount || 0),
      collected: el.dataset.collected || "",
      title: el.dataset.title || "",
    }));

    let activePlatform = "all";

    function normalize(s: string) {
      return s
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .toLowerCase();
    }

    function setActivePill(platform: string) {
      activePlatform = platform;
      pillsWrap!.querySelectorAll(".store-filter-btn").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.platformFilter === platform;
        btn.classList.toggle("bg-primary", isActive);
        btn.classList.toggle("text-on-primary", isActive);
        btn.classList.toggle("bg-surface-container-lowest", !isActive);
        btn.classList.toggle("text-text-muted", !isActive);
      });
    }

    function render() {
      const query = normalize(searchInput!.value.trim());
      const sortMode = sortSelect!.value;

      let visible = cards.filter((c) => {
        const platformOk = activePlatform === "all" || c.platform === activePlatform;
        const queryOk = !query || c.title.includes(query);
        return platformOk && queryOk;
      });

      visible = visible.sort((a, b) =>
        sortMode === "discount" ? b.discount - a.discount : b.collected.localeCompare(a.collected)
      );

      cards.forEach((c) => {
        c.el.classList.toggle("hidden", !visible.includes(c));
        c.el.classList.toggle("flex", visible.includes(c));
      });
      visible.forEach((c, i) => {
        c.el.style.order = String(i);
      });

      resultsCount!.textContent =
        visible.length === cards.length
          ? `${visible.length} ofertas agora`
          : `${visible.length} de ${cards.length} ofertas`;

      emptyState!.classList.toggle("hidden", visible.length > 0);
      emptyState!.classList.toggle("flex", visible.length === 0);
    }

    pillsWrap.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-platform-filter]");
      if (!btn) return;
      const platform = btn.dataset.platformFilter || "all";
      setActivePill(platform);
      render();
      track("filter_platform", { platform });
    });

    sortSelect.addEventListener("change", () => {
      render();
      track("sort_offers", { sort_mode: sortSelect!.value });
    });

    let searchDebounce: ReturnType<typeof setTimeout>;
    searchInput.addEventListener("input", () => {
      render();
      clearTimeout(searchDebounce);
      const term = searchInput!.value.trim();
      if (!term) return;
      // espera parar de digitar antes de logar — evita 1 evento por tecla
      searchDebounce = setTimeout(() => track("search", { search_term: term }), 800);
    });

    resetBtn?.addEventListener("click", () => {
      searchInput.value = "";
      setActivePill("all");
      render();
    });

    render();
  }
</script>
