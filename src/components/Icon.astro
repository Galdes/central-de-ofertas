---
interface Props {
  name: "flame" | "search" | "chevron-down" | "star" | "arrow-up-right" | "info" | "search-off";
  class?: string;
}
const { name, class: className = "" } = Astro.props;

const STROKE_ICONS: Record<string, string> = {
  search: '<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  "chevron-down": '<polyline points="6 9 12 15 18 9"/>',
  "arrow-up-right": '<line x1="7" y1="17" x2="17" y2="7"/><polyline points="8 7 17 7 17 16"/>',
  info: '<circle cx="12" cy="12" r="9"/><line x1="12" y1="16" x2="12" y2="11.5"/><circle cx="12" cy="8" r="0.5" fill="currentColor"/>',
  "search-off": '<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="4" y1="4" x2="20" y2="20"/>',
};

const FILL_ICONS: Record<string, string> = {
  flame:
    '<path d="M12 2c-.6 2.6-2.6 3.9-4 5.6C6.6 9.4 6 11 6 12.5 6 17.2 8.7 21 12 21s6-3.8 6-8.5c0-2.2-1.1-4-2.3-5.6.2 1.4-.2 2.6-1 3.3-.2-2.8-1.3-5.1-2.7-6.6C11.6 5.3 11 6.6 11 8c0 .9.3 1.6.8 2.2-1.6-.4-2.8-2-2.8-3.8C9 5 10.2 3.2 12 2Z"/>',
  star: '<path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.6l-5.9 3.1 1.2-6.6-4.8-4.6 6.6-.9L12 2.5Z"/>',
};

const isStroke = name in STROKE_ICONS;
const inner = isStroke ? STROKE_ICONS[name] : FILL_ICONS[name];
---

{
  isStroke ? (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={inner}
    />
  ) : (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={inner} />
  )
}
